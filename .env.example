# Local personal mode defaults to SQLite when DATABASE_URL is unset.
# DATABASE_URL=postgres://mspace:mspace@127.0.0.1:5432/mspace?sslmode=disable
# MSPACE_STORE=sqlite
# MSPACE_SQLITE_PATH=/path/to/mspace.db
# MSPACE_DATA_DIR=/path/to/mspace-data

# Optional. Only set all three when GitHub OAuth should be available.
# MSPACE_GITHUB_CLIENT_ID=your_github_oauth_client_id
# MSPACE_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# MSPACE_GITHUB_REDIRECT_URI=http://127.0.0.1:8787/api/auth/github/callback

# Optional. Separate from OAuth; only set all three when GitHub App automation readiness should be available.
# MSPACE_GITHUB_APP_ID=your_github_app_id
# MSPACE_GITHUB_APP_CLIENT_ID=your_github_app_client_id
# MSPACE_GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

MSPACE_SERVER_ADMIN_LOGINS=admin
MSPACE_BOOTSTRAP_ADMIN_LOGIN=admin
MSPACE_BOOTSTRAP_ADMIN_PASSWORD=change-me-long-random-password
MSPACE_BOOTSTRAP_ADMIN_NAME=Admin
MSPACE_SERVER_ADDR=127.0.0.1:8787
