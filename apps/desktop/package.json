{
  "name": "@mspace/desktop",
  "version": "0.2.0-rc.1",
  "private": true,
  "description": "Desktop workspace plus server control plane for coding agents, issue review, and Kubernetes validation evidence.",
  "homepage": "https://github.com/mlhiter/mspace",
  "author": {
    "name": "mspace"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepare:release": "node scripts/prepare-release.mjs",
    "package:dir": "pnpm run prepare:release && electron-vite build && electron-builder --dir",
    "dist": "pnpm run prepare:release && electron-vite build && electron-builder",
    "dist:mac": "node scripts/prepare-release.mjs --target=darwin && electron-vite build && electron-builder --mac",
    "dist:win": "node scripts/prepare-release.mjs --target=win32 --arch=x64 && electron-vite build && electron-builder --win --x64",
    "dist:linux": "node scripts/prepare-release.mjs --target=linux --arch=x64 && electron-vite build && electron-builder --linux --x64",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:main && pnpm run typecheck:renderer",
    "lint": "echo 'lint not configured yet'",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@mspace/core": "workspace:*",
    "@mspace/i18n": "workspace:*",
    "@mspace/ui": "workspace:*",
    "@mspace/views": "workspace:*",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.169.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^39.2.6",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
